@page
@model RegisterModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <h2>Yeni Hesap Oluştur</h2>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- Ad Soyad -->
            <div class="form-floating mb-3">
                <input asp-for="Input.FullName"
                       class="form-control"
                       autocomplete="name"
                       aria-required="true"
                       placeholder="Ad Soyad" />
                <label asp-for="Input.FullName">Ad Soyad</label>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">E-posta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Şifre -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Şifre" />
                <label asp-for="Input.Password">Şifre</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Şifre Tekrarı -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Şifre Tekrarı" />
                <label asp-for="Input.ConfirmPassword">Şifre Tekrarı</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="w-100 btn btn-lg btn-primary">
                Kayıt Ol
            </button>

        </form>
    </div>

    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>Diğer Giriş Yöntemleri</h3>
            <hr />

            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <p>Harici giriş hizmeti yapılandırılmamıştır.</p>
            }
            else
            {
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      class="form-horizontal">

                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit"
                                class="btn btn-primary"
                                name="provider"
                                value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
