@model IEnumerable<VeterinerKlinigiMVC.Models.Pet>

@{
    ViewData["Title"] = "Evcil Hayvanlarım";
}

<h1>Evcil Hayvanlarım</h1>

<hr />

<p>
    <a asp-action="Create" class="btn btn-success">
        + Yeni Hayvan Ekle
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz kayıtlı evcil hayvanınız bulunmamaktadır.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Hayvan Adı</th>
                    <th>Tür</th>
                    <th>Irk</th>
                    <th>Doğum Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>

                        <td>@item.Species</td>

                        <td>@item.Breed</td>

                        <td>
                            @item.BirthDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Detay
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Düzenle
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Sil
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}
