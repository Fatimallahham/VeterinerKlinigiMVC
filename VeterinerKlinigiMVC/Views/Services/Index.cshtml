@model IEnumerable<VeterinerKlinigiMVC.Models.Service>

@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<h1 class="mb-4">Hizmet Yönetimi</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        + Yeni Hizmet Ekle
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz kayıtlı hizmet bulunmamaktadır.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Hizmet Adı</th>
                    <th>Açıklama</th>
                    <th>Süre</th>
                    <th>Ücret</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>

                        <td>@(item.Description ?? "-")</td>

                        <td>@item.Duration dk</td>

                        <td>
                            @item.Price.ToString("N2",
                                    System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) TL
                        </td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Pasif
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Düzenle
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Detaylar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}